# ============================================================
# Copie para .env e preencha. NUNCA commite o arquivo .env.
# ============================================================

# Ambiente: development | production
# Em production a aplicação se recusa a subir sem SECRET_KEY.
ENVIRONMENT=development

# Chave de assinatura dos tokens JWT (mínimo 32 caracteres em produção).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# OpenAI / LLM
OPENAI_API_KEY=coloque-sua-chave-openai-aqui
LLM_MODEL=gpt-4o-mini

# LangSmith opcional
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=coloque-sua-chave-langsmith-aqui
LANGSMITH_PROJECT=mba-ia-pull-evaluation-api

# Banco de dados
DATABASE_URL=sqlite:///./app.db

# Admin local de desenvolvimento (ignorado em produção).
# Se DEV_ADMIN_PASSWORD ficar vazia, uma senha aleatória é gerada
# e mostrada uma única vez no log do servidor.
CREATE_DEV_ADMIN=true
DEV_ADMIN_EMAIL=admin@exemplo.com
DEV_ADMIN_PASSWORD=

# HTTP
# Domínios autorizados a chamar a API de outro site (separados por vírgula).
CORS_ORIGINS=
# Swagger em /docs (padrão: ligado em desenvolvimento, desligado em produção)
# DOCS_ENABLED=true

# Limites de requisição por IP
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_GENERATE=6/minute

# Custo do LLM (US$ por 1 milhão de tokens) — confira a tabela da OpenAI
LLM_PRICE_INPUT_PER_1M=0.15
LLM_PRICE_OUTPUT_PER_1M=0.60

# Fila de gerações
JOB_WORKERS=2
MAX_PENDING_JOBS_PER_USER=2

# Armazenamento dos projetos gerados
GENERATED_PROJECTS_DIR=generated_projects
# Armazenamento S3/R2 (opcional; recomendado em produção).
# Credenciais via AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY.
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
STORAGE_PREFIX=generated_projects/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cobrança (Asaas)
# Sandbox para testes; troque URL e chave juntas ao ir para produção.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Mesmo valor configurado no webhook do painel da Asaas.
ASAAS_WEBHOOK_TOKEN=
# Preço mensal em R$ de cada plano pago
PLAN_PRICE_PRO=49.90
PLAN_PRICE_TEAM=199.90
# Dias de tolerância após o vencimento antes de voltar ao plano free
BILLING_GRACE_DAYS=3

# ------------------------------------------------------------
# Dados do vendedor (rodapé, Termos de Uso e Política de Privacidade)
# ------------------------------------------------------------
# Não coloque esses valores no código: o repositório é público.
SELLER_NAME=
# CPF ou CNPJ, com ou sem pontuação.
SELLER_DOCUMENT=
CONTACT_EMAIL=
SELLER_CITY=Porto Alegre/RS
# Data da versão vigente dos termos (AAAA-MM-DD). Ao mudar o texto de forma
# relevante, atualize: contas antigas terão de aceitar de novo ao assinar.
TERMS_VERSION=2026-09-30

# ------------------------------------------------------------
# E-mail (SMTP) — usado no "Esqueci minha senha"
# ------------------------------------------------------------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=seu@gmail.com,
# SMTP_PASSWORD=<senha de app de 16 letras> (exige verificação em 2 etapas).
# Sem SMTP_HOST, nenhum e-mail é enviado (em desenvolvimento o link vai para o log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Remetente (padrão: SMTP_USERNAME) e nome exibido.
EMAIL_FROM=
EMAIL_FROM_NAME=MBA IA - Bug Evaluation
# Endereço público usado nos links dos e-mails. No Render é detectado sozinho.
PUBLIC_BASE_URL=
PASSWORD_RESET_EXPIRE_MINUTES=60
